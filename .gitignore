# Initial repository allowlist: this workspace also contains unrelated projects.
# Explicitly allow new application roots here when implementation begins.
/*
!/.gitignore
!/README.md
!/docs/
/docs/*
!/docs/superpowers/
/docs/superpowers/*
!/docs/superpowers/specs/
!/docs/superpowers/plans/
!/docs/superpowers/notes/
!/docs/superpowers/reports/

# Project roots added for implementation (keep this list minimal and explicit).
!/tools/
/tools/*
!/tools/voice-check/
# Recorded test audio stays local; the *.wav rule below also covers this.
/tools/voice-check/cases/audio/
/tools/voice-check/cases/noise-30min/
/tools/voice-check/cases/self-trigger/

!/apps/
/apps/*

# Voice service (Python) and the Unity house project.
!/apps/voice-service/
/apps/voice-service/*
!/apps/voice-service/src/
!/apps/voice-service/tests/
!/apps/voice-service/requirements.lock.txt
!/apps/voice-service/pyproject.toml
!/apps/voice-service/README.md
/apps/voice-service/.venv/

!/apps/home-service/
/apps/home-service/*
!/apps/home-service/src/
!/apps/home-service/tests/
!/apps/home-service/config/
!/apps/home-service/requirements.lock.txt
!/apps/home-service/pyproject.toml
!/apps/home-service/README.md

# Unity house. Track the project only; generated folders stay local.
!/apps/unity-house/
/apps/unity-house/*
!/apps/unity-house/Assets/
!/apps/unity-house/Packages/
!/apps/unity-house/ProjectSettings/
!/apps/unity-house/.gitignore
!/apps/unity-house/README.md
# Re-assert generated-folder exclusions for this project.
/apps/unity-house/Library/
/apps/unity-house/Temp/
/apps/unity-house/Obj/
/apps/unity-house/Build/
/apps/unity-house/Builds/
/apps/unity-house/Logs/
/apps/unity-house/UserSettings/
/apps/unity-house/.vs/

# Secrets and local configuration
.env
.env.*
!.env.example
*.pem
*.key
*.pfx
*.p12
credentials.json
secrets.json

# Dependencies, Python state and model artifacts
node_modules/
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.cache/
models/
*.onnx
*.pt
*.pth
*.safetensors
*.gguf

# Local diagnostics, recordings and audio artifacts.
# All audio is local test data: never commit it. Un-ignore a specific file with
# an explicit `!` rule only if it is genuinely meant to be documentation.
*.log
*.wav
*.pcm
*.mp3
*.m4a
*.flac
recordings/
.superpowers/

# Acceptance result files are regenerated per run; only commit a real outcome
# deliberately (git add -f) once a phase gate has actually been evaluated.
docs/superpowers/reports/artifacts/asr-results.json
docs/superpowers/reports/artifacts/wake-results.json
docs/superpowers/reports/artifacts/tts-listening.json

# Unity generated content (do not ignore Assets, Packages, ProjectSettings or .meta)
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
.vs/
